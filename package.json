{
  "name": "hearthshelf-webapp",
  "version": "0.1.0",
  "description": "The hosted HearthShelf web application - a unified front door (app.hearthshelf.com) for reaching any HearthShelf / AudiobookShelf server you have access to.",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "sync-core": "git submodule update --remote packages/core",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@better-auth/passkey": "^1.7.7",
    "@sentry/react": "^11.4.0",
    "@tanstack/react-query": "^5.104.1",
    "better-auth": "^1.7.7",
    "epubjs": "0.3.93",
    "lucide-react": "^1.51.0",
    "qrcode": "1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "sonner": "^2.0.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  },
  "overrides": {
    "@xmldom/xmldom": "0.9.12"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
