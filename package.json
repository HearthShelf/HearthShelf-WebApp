{
  "name": "hearthshelf-webapp",
  "version": "0.1.0",
  "description": "The hosted HearthShelf web application - a unified front door (app.hearthshelf.com) for reaching any HearthShelf / AudiobookShelf server you have access to.",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "sync-core": "git submodule update --remote packages/core",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@clerk/clerk-react": "^5.61.9",
    "@tanstack/react-query": "^5.101.4",
    "epubjs": "0.3.93",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "sonner": "^2.0.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  },
  "overrides": {
    "@xmldom/xmldom": "0.9.10"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "@clerk/shared@3.47.8": true
  }
}
