{
  "name": "hearthshelf-mcp-server",
  "version": "0.1.0",
  "description": "Remote MCP server for HearthShelf - lets any MCP client (Claude, etc.) read a user's library, reading history and recommendations so the client's own model can answer 'does this book fit me?'. Read-only; holds no long-lived ABS credential.",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^0.10.3",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "agents": "^0.22.0",
    "hono": "^4.13.7",
    "jose": "^6.2.12",
    "zod": "^4.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260908.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.130.0"
  },
  "overrides": {
    "fast-uri": "3.1.6",
    "qs": "6.16.0",
    "sharp": "0.35.4"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260908.1": true
  }
}
